#!/bin/bash

set -euo pipefail

echo '--- Setting clone flags'

echo "current settings:"
echo "BUILDKITE_GIT_CLONE_MIRROR_FLAGS=${BUILDKITE_GIT_CLONE_MIRROR_FLAGS:-}"
echo "BUILDKITE_GIT_CLONE_FLAGS=${BUILDKITE_GIT_CLONE_FLAGS:-}"
echo "BUILDKITE_GIT_FETCH_FLAGS=${BUILDKITE_GIT_FETCH_FLAGS:-}"

echo "blobby"
export BUILDKITE_GIT_CLONE_MIRROR_FLAGS="-v --mirror --filter=blob:none"

# export BUILDKITE_GIT_CLONE_FLAGS="-v --disassociate"
